SELECT seller_id, seller_name
FROM sellers;

SELECT product_id, product_name
FROM products;

INSERT INTO inventory
(seller_id, product_id, stock_quantity, availability_status, last_updated)
VALUES
(1, 1, 8, 'Available', '2026-09-30'),
(1, 2, 25, 'Available', '2026-09-30'),
(2, 3, 50, 'Available', '2026-09-30'),
