SELECT * FROM reviews;

SELECT * FROM ratings;

SELECT
    r.review_id,
    r.customer_id,
    p.product_name,
    r.review_text,
    r.review_date,
    rt.rating
FROM reviews r
JOIN products p
    ON r.product_id = p.product_id
JOIN ratings rt
    ON r.review_id = rt.review_id
ORDER BY r.review_date;

SELECT
    p.product_id,
    p.product_name,
    AVG(rt.rating) AS average_rating
FROM products p
JOIN ratings rt
    ON p.product_id = rt.product_id
GROUP BY p.product_id, p.product_name
ORDER BY average_rating DESC;

SELECT
    p.product_id,
    p.product_name,
    COUNT(rt.rating_id) AS total_reviews,
    AVG(rt.rating) AS average_rating,
    MIN(rt.rating) AS minimum_rating,
    MAX(rt.rating) AS maximum_rating
FROM products p
JOIN ratings rt
    ON p.product_id = rt.product_id
GROUP BY p.product_id, p.product_name
ORDER BY average_rating DESC;

SELECT
    p.product_name,
    AVG(rt.rating) AS average_rating
FROM products p
JOIN ratings rt
    ON p.product_id = rt.product_id
GROUP BY p.product_id, p.product_name
HAVING AVG(rt.rating) >= 4
ORDER BY average_rating DESC;

SELECT
    p.product_name,
    COUNT(rt.rating_id) AS total_ratings,
    AVG(rt.rating) AS average_rating
FROM products p
JOIN ratings rt
    ON p.product_id = rt.product_id
GROUP BY p.product_id, p.product_name
HAVING AVG(rt.rating) = 5
ORDER BY average_rating DESC;
